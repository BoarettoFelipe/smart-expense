#!/bin/bash
set -euo pipefail

dnf install -y docker
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli2
fi

systemctl enable --now docker
# The selected standard AL2023 AMI already includes SSM Agent.
systemctl enable --now amazon-ssm-agent

# Pin and verify the official x86_64 Compose plugin; install for all host users.
compose_tmp=$(mktemp -d)
trap 'rm -f "$compose_tmp/docker-compose-linux-x86_64" "$compose_tmp/docker-compose-linux-x86_64.sha256"; rmdir "$compose_tmp"' EXIT
compose_release="https://github.com/docker/compose/releases/download/${docker_compose_version}"
curl --fail --show-error --silent --location --retry 3 \
  "$compose_release/docker-compose-linux-x86_64" \
  --output "$compose_tmp/docker-compose-linux-x86_64"
curl --fail --show-error --silent --location --retry 3 \
  "$compose_release/docker-compose-linux-x86_64.sha256" \
  --output "$compose_tmp/docker-compose-linux-x86_64.sha256"
(cd "$compose_tmp" && sha256sum --check docker-compose-linux-x86_64.sha256)
install -D -m 0755 "$compose_tmp/docker-compose-linux-x86_64" \
  /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

# No application images or secrets are fetched during bootstrap.

# Non-secret deployment inputs. Plain KEY=value syntax; no shell quoting.
AWS_REGION=us-east-1
ECR_REGISTRY=739275443630.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=demo-001
# Use Terraform's non-sensitive outputs; hostname WITHOUT :5432.
RDS_HOST=replace-with-rds-hostname.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=smartexpense
RDS_USERNAME=smartexpense
DB_PASSWORD_PARAMETER=/smart-expense/demo/db-password
JWT_SIGNING_KEY_PARAMETER=/smart-expense/demo/jwt-signing-key

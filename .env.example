POSTGRES_DB=smart_expense
POSTGRES_USER=smart_expense
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SIGNING_KEY=replace-with-a-unique-random-local-key-at-least-32-bytes

# Optional host/runtime overrides. Defaults are shown.
POSTGRES_HOST_PORT=5432
FRONTEND_HOST_PORT=8080
POSTGRES_VOLUME_NAME=smart-expense-postgres-data
